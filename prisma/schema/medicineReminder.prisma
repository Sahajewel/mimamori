// ─── MedicineReminder ────────────────────────────────

model MedicineReminder {
    id         String        @id @default(uuid())
    medicineId String
    medicine   Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
    time       String // "08:00", "22:00" format
    createdAt  DateTime      @default(now())
    logs       MedicineLog[]

    @@index([medicineId])
}
