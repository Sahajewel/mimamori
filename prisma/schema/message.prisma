model Message {
  id        String    @id @default(uuid())
  seniorId  String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  imageUrl  String?
  deletedAt DateTime?
  editedAt  DateTime?
  senior    Senior    @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seniorId])
}
