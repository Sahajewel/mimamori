model Message {
    id        String    @id @default(uuid())
    seniorId  String
    senior    Senior    @relation(fields: [seniorId], references: [id], onDelete: Cascade)
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    content   String
    imageUrl  String?
    createdAt DateTime  @default(now())
    deletedAt DateTime?

    @@index([seniorId])
}
