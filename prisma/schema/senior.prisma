model Senior {
  id          String         @id @default(uuid())
  name        String
  age         Int?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  quickToken  String?        @unique
  photoUrl    String?
  careNotes   CareNote[]
  checkIns    CheckIn[]
  invitations Invitation[]
  medicines   Medicine[]
  messages    Message[]
  members     SeniorMember[]

  @@index([id])
  @@index([quickToken])
}
