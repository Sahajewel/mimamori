// ─── Senior ──────────────────────────────────────────

model Senior {
    id          String         @id @default(uuid())
    name        String
    age         Int?
    notes       String?
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt
    members     SeniorMember[]
    checkIns    CheckIn[]
    medicines   Medicine[]
    careNotes   CareNote[]
    invitations Invitation[]

    @@index([id])
}
