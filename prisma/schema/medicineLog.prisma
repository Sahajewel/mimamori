// ─── MedicineLog ─────────────────────────────────────
model MedicineLog {
    id         String           @id @default(uuid())
    medicineId String
    medicine   Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
    reminderId String
    reminder   MedicineReminder @relation(fields: [reminderId], references: [id])
    userId     String? // user hard-delete হলে null
    user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
    authorName String? // user মুছলেও নাম থেকে যাবে
    status     MedicineStatus   @default(PENDING)
    takenAt    DateTime?
    note       String?
    createdAt  DateTime         @default(now())

    @@index([medicineId])
    @@index([reminderId])
    @@index([userId, status])
    @@index([createdAt])
}
