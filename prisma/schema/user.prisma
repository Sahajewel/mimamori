// ─── User ────────────────────────────────────────────

model User {
    id              String         @id @default(uuid())
    name            String
    email           String         @unique
    passwordHash    String
    role            Role           @default(FAMILY)
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    seniorMembers   SeniorMember[]
    checkIns        CheckIn[]
    careNotes       CareNote[]
    medicineLogs    MedicineLog[]
    invitationsSent Invitation[]

    @@index([email])
    @@index([role])
}
